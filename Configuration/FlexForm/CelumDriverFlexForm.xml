<?xml version="1.0" encoding="utf-8"?>
<T3DataStructure>
    <ROOT>
        <type>array</type>
        <el>
            <licenseKey>
                <label>License Key</label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>256</size>
                </config>
            </licenseKey>
            <celumApiKey>
                <label>Celum API key</label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>256</size>
                </config>
            </celumApiKey>
            <locale>
                <label>Locale</label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>2</size>
                </config>
            </locale>
            <defaultLocale>
                <label>Default locale</label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>2</size>
                </config>
            </defaultLocale>
            <roots>
                <label>Root nodes (comma separated list of ids)</label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>256</size>
                </config>
            </roots>
            <imageDownloadFormat>
                <label>Download format for images (download format ID, prvw, thumb, largeprvw (recommended, optimized),
                    thumb or orig)
                </label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>256</size>
                    <default>largeprvw</default>
                </config>
            </imageDownloadFormat>
            <videoDownloadFormat>
                <label>Download format for videos (download format ID, prvw, thumb, largeprvw, thumb or orig
                    (recommended))
                </label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>256</size>
                    <default>orig</default>
                </config>
            </videoDownloadFormat>
            <othersDownloadFormat>
                <label>Download format for other file categories (download format ID, prvw, thumb, largeprvw, thumb or
                    orig (recommended))
                </label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>256</size>
                    <default>orig</default>
                </config>
            </othersDownloadFormat>
            <directDownloadSecret>
                <label>Direct Download secret</label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>256</size>
                </config>
            </directDownloadSecret>
            <descriptionFieldName>
                <label>Description field name ([localized] text [area])</label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>256</size>
                </config>
            </descriptionFieldName>
            <alternativeTextFieldName>
                <label>Alternative text field name ([localized] text [area])</label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>256</size>
                </config>
            </alternativeTextFieldName>
            <infoFieldSetterToken>
                <label>Token for the infoFieldSetter (required to write public URLs and for bullets)</label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>256</size>
                </config>
            </infoFieldSetterToken>
            <writePublicUrls>
                <label>Write public URLs (uncheck to only use bullets)</label>
                <config>
                    <type>check</type>
                    <default>1</default>
                </config>
            </writePublicUrls>
            <informationFieldId>
                <label>Information field ID (checkbox or noderef, required for bullets)</label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>256</size>
                </config>
            </informationFieldId>
            <nodeId>
                <label>Node ID (node id to add to nodeRef field, if empty checkbox assumed)</label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>256</size>
                </config>
            </nodeId>
            <publicURLsProviderImage>
                <label>PublicUrls Provider for Images</label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>256</size>
                </config>
            </publicURLsProviderImage>
            <publicURLsDescriptionImage>
                <label>PublicUrls Description for Images</label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>256</size>
                </config>
            </publicURLsDescriptionImage>
            <publicURLsProviderVideo>
                <label>PublicUrls Provider for Videos</label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>256</size>
                </config>
            </publicURLsProviderVideo>
            <publicURLsDescriptionVideo>
                <label>PublicUrls Description for Videos</label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>256</size>
                </config>
            </publicURLsDescriptionVideo>
            <cacheLifetimeInMinutes>
                <label>Cache lifetime in minutes (0 &lt; lifetime &lt; 30)</label>
                <config>
                    <type>input</type>
                    <eval>trim</eval>
                    <size>4</size>
                    <default>29</default>
                </config>
            </cacheLifetimeInMinutes>
        </el>
    </ROOT>
</T3DataStructure>
