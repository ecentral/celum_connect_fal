{
	"name": "ecentral/celum-connect-fal",
	"authors": [
		{
			"name": "brix IT solutions",
			"role": "Project Owner",
			"email": "support@brix.ch",
			"homepage": "https://www.brix.ch"
		}
	],
	"prefer-stable": true,
	"type": "typo3-cms-extension",
	"description": "TYPO3 FAL driver for the CELUM DAM system",
	"homepage": "https://github.com/ecentral/celum_connect_fal",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"typo3",
		"typo3 backend",
		"celum",
		"fal",
		"dam",
		"digital asset management",
		"file abstraction layer"
	],
	"autoload": {
		"psr-4": {
			"Brix\\CelumFal\\": "Classes/"
		}
	},
	"config": {
		"vendor-dir": ".Build/vendor",
		"bin-dir": ".Build/bin",
		"preferred-install": {
			"typo3/cms-core": "source"
		},
		"sort-packages": true,
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		}
	},
	"require": {
		"typo3/cms-core": "^12 || ^13",
		"guzzlehttp/psr7": "*",
		"ecentral/celum-connect-fal-rest-client": "^1.0"
	},
	"require-dev": {
		"codeception/codeception": "^5.3",
		"codeception/module-asserts": "^3.3",
		"codeception/module-cli": "^2.0",
		"codeception/module-webdriver": "^4.0",
		"phpstan/phpstan": "^1.2.0",
		"typo3/cms-frontend": "^12 || ^13",
		"typo3/cms-install": "^12 || ^13",
		"typo3/cms-filelist": "^12 || ^13",
		"typo3/coding-standards": "^0.8.0",
		"typo3/tailor": "^1.2",
		"typo3/testing-framework": "^8.0.6"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload-dev": {
		"psr-4": {
			"Brix\\CelumFal\\Tests\\": "Tests"
		}
	},
	"scripts": {
		"phpcsfixer": "php-cs-fixer fix --dry-run --diff --using-cache=no --config=.php-cs-fixer.dist.php",
		"phpstan": "phpstan analyse Classes Configuration ext_emconf.php ext_localconf.php --level=5",
		"test:unit": "phpunit -c Build/phpunit/UnitTests.xml"
	},
	"extra": {
		"typo3/cms": {
			"app-dir": ".Build",
			"web-dir": ".Build/Web",
			"extension-key": "celum_connect_fal"
		}
	}
}
