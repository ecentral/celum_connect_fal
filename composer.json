{
  "name": "brix/celum-connect-fal",
  "type": "typo3-cms-extension",
  "description": "Provides a FAL driver for the CELUM DAM.",
  "keywords": [
    "celum", "dam", "brix", "fal"
  ],
  "license": [
    "GPL-2.0+"
  ],
  "authors": [
    {
      "name": "brix IT solutions",
      "role": "Project Owner",
      "email": "support@brix.ch",
      "homepage": "https://www.brix.ch"
    }
  ],
  "require": {
    "typo3/cms-core": ">=11.0.0",
    "ext-json": "*",
    "ext-sysvsem": "*"
  },
  "autoload": {
    "psr-4": {
      "Brix\\CelumFal\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Brix\\CelumFal\\Tests\\": "Tests/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "celum_connect_fal",
      "web-dir": ".Build/Web",
      "cms-package-dir": "{$vendor-dir}/typo3/cms"
    }
  },
  "config": {
    "vendor-dir": ".Build/vendor",
    "bin-dir": ".Build/bin"
  },
  "require-dev": {
    "typo3/testing-framework": "^6.15"
  }
}
