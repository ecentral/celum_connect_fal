{
	"name": "brix/celum-connect-fal",
	"authors": [
		{
			"name": "brix IT solutions",
			"role": "Project Owner",
			"email": "support@brix.ch",
			"homepage": "https://www.brix.ch"
		}
	],
	"type": "typo3-cms-extension",
	"description": "TYPO3 FAL driver for the CELUM DAM system",
	"homepage": "https://github.com/ecentral/celum_connect_fal",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"typo3",
		"typo3 backend",
		"celum",
		"fal",
		"dam",
		"digital asset management",
		"file abstraction layer"
	],
	"autoload": {
		"psr-4": {
			"Brix\\CelumFal\\": "Classes/"
		}
	},
	"config": {
		"vendor-dir": ".Build/vendor",
		"bin-dir": ".Build/bin",
		"preferred-install": {
			"typo3/cms-core": "source"
		},
		"sort-packages": true
	},
	"require": {
		"typo3/cms-core": "^12 || ^13",
		"guzzlehttp/psr7": "*",
		"ecentral/celum-connect-fal-rest-client": "^1.0"
	},
	"require-dev": {
		"codeception/codeception": "^4.1",
		"codeception/module-asserts": "^1.2",
		"codeception/module-cli": "^1.1",
		"codeception/module-webdriver": "^1.1",
		"phpstan/phpstan": "^1.2.0",
		"typo3/cms-frontend": "^12 || ^13",
		"typo3/cms-install": "^12 || ^13",
		"typo3/cms-filelist": "^12 || ^13",
		"typo3/coding-standards": "^0.3.0",
		"typo3/tailor": "^1.2",
		"typo3/testing-framework": "^6.14.0"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload-dev": {
		"psr-4": {
			"Brix\\CelumFal\\Tests\\": "Tests"
		}
	},
	"extra": {
		"typo3/cms": {
			"app-dir": ".Build",
			"web-dir": ".Build/Web",
			"extension-key": "celum_connect_fal"
		}
	}
}
